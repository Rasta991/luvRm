# Local env — copy to `.env` and fill in your Supabase project values.
# Required for cross-device Watch Party Realtime sync.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Optional
# VITE_TMDB_API_KEY=
# VITE_SOCKET_URL=

# Stream resolver for local development. When set, fetchDirectStreamUrl
# calls this URL directly instead of the same-origin /api/stream edge
# function. Useful when you don't want to run `vercel dev` locally.
# In production, leave it unset so requests go through /api/stream,
# which forwards to your server-side STREAM_RESOLVER_URL.
# VITE_STREAM_RESOLVER_URL=http://localhost:3000/api/stream

# Subtitle lookup (SubDL). The VITE_ prefix exposes the variable to the
# client bundle; without it, only the serverless function sees it.
#
# Set VITE_SUBDL_PROXY_URL to /api/subtitles to use the bundled proxy
# (recommended — keeps the SubDL key off the client).
# When unset, the client calls api.subdl.com directly using the
# VITE_SUBDL_API_KEY (CORS-blocked in production browsers, fine for dev).
# VITE_SUBDL_PROXY_URL=/api/subtitles
# VITE_SUBDL_API_KEY=

# Server-only (used by api/subtitles.ts). NOT exposed to the client.
# SUBDL_API_KEY=
# TMDB_API_KEY=
